[MAIN]
# Add src/ to the Python path so pylint can resolve local imports
# (matches Docker working_dir: /src)
init-hook="import sys; sys.path.insert(0, 'src')"

[MESSAGES CONTROL]
# Minimal: only rules that catch actual runtime errors and logic bugs.
# All style (C) and design-opinion (R) checks are disabled.
disable=
    # Entire categories: convention (style) and refactoring (design opinions)
    C,
    R,
    # Verbosity noise from inline suppressions
    locally-disabled,
    suppressed-message,
    # Project-specific false positives
    fixme,                      # TODO/FIXME comments are intentional
    unused-argument,            # Telegram/APScheduler callback signatures are fixed
    undefined-variable,         # names from wildcard imports (constants.py)
    import-error,               # imports resolve via Docker PYTHONPATH

enable=
    useless-suppression,        # flag stale # pylint: disable= comments

[FORMAT]
max-line-length=120

[BASIC]
# Allow single-letter variable names in loops/short functions
good-names=i,j,k,e,x,_,fp
